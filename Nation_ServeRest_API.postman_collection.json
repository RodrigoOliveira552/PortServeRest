  "item": [
    {
      "name": "Criar Usuários",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// 1. Validar se o servidor respondeu com o Status correto (201 Created)\r",
              "pm.test(\"Status code é 201 Created\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "// Parse do corpo da resposta para um formato que o JavaScript entende (JSON)\r",
              "var jsonData = pm.response.json();\r",
              "\r",
              "// 2. Validar se a mensagem de sucesso está exatamente como a documentação exige\r",
              "pm.test(\"Mensagem de sucesso está correta\", function () {\r",
              "    pm.expect(jsonData.message).to.eql(\"Cadastro realizado com sucesso\");\r",
              "});\r",
              "\r",
              "// 3. Validar se o servidor realmente gerou o ID do usuário (Garantia de que o banco gravou)\r",
              "pm.test(\"Resposta contém o _id do usuário criado\", function () {\r",
              "    pm.expect(jsonData).to.have.property(\"_id\");\r",
              "    pm.expect(jsonData._id).to.be.a(\"string\");\r",
              "\r",
              "    // 4. Captura o ID da resposta e salva numa variável da Collection chamada \"idUsuario\"\r",
              "pm.collectionVariables.set(\"idUsuario\", jsonData._id);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"nome\": \"Teste2 Nation\",\r\n  \"email\": \"{{$randomEmail}}\",\r\n  \"password\": \"teste\",\r\n  \"administrador\": \"true\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://serverest.dev/usuarios",
          "protocol": "https",
          "host": [
            "serverest",
            "dev"
          ],
          "path": [
            "usuarios"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Buscar Usuário por ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code é 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "var jsonData = pm.response.json();\r",
              "\r",
              "pm.test(\"O ID retornado é o mesmo do usuário recém-criado\", function () {\r",
              "    // Aqui validamos se o ID que veio na resposta bate com a variável que salvamos no POST\r",
              "    pm.expect(jsonData._id).to.eql(pm.collectionVariables.get(\"idUsuario\"));\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://serverest.dev/usuarios/{{idUsuario}}",
          "protocol": "https",
          "host": [
            "serverest",
            "dev"
          ],
          "path": [
            "usuarios",
            "{{idUsuario}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Deletar Usuário",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code é 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "var jsonData = pm.response.json();\r",
              "\r",
              "pm.test(\"Mensagem de exclusão correta\", function () {\r",
              "    // Validamos a 'message' em vez do '_id'\r",
              "    pm.expect(jsonData.message).to.eql(\"Registro excluído com sucesso\");\r",
              "});\r",
              "\r",
              "// Ações de Limpeza (Boas práticas de Senior)\r",
              "// Já que o usuário não existe mais, apagamos a variável da memória para não vazar dados\r",
              "pm.collectionVariables.unset(\"idUsuario\");"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://serverest.dev/usuarios/{{idUsuario}}",
          "protocol": "https",
          "host": [
            "serverest",
            "dev"
          ],
          "path": [
            "usuarios",
            "{{idUsuario}}"
          ]
        }
      },
      "response": []
